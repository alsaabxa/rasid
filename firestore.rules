rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'OWNER_EMAIL_CHANGE_ME';
    }
    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.schoolId == uid;
      allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow update, delete: if isOwner();
    }
    match /schools/{schoolId} {
      allow read, write: if isOwner();
      match /private/{docId} {
        allow read, write: if request.auth != null && (
          isOwner() || (profile(request.auth.uid).status == 'approved'
            && profile(request.auth.uid).schoolId == schoolId)
        );
      }
    }
  }
}
