{
  "name": "rasid-tests",
  "private": true,
  "description": "اختبارات راصد: المزامنة اللحظية والعزل وعدد القراءات (بدون اعتماديات) + اختبار قواعد Firestore بالمُحاكي",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rasid-rules \"node --test tests/rules/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.0.0"
  }
}
