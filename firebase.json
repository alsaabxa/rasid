{
  "hosting": {
    "target": "production",
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "README.md", "FIRESTORE_STORAGE_V2_TEST_PLAN.md", ".firebaserc", ".*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [{
      "source": "**",
      "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]
    }]
  },
  "firestore": { "rules": "firestore.rules" }
}
